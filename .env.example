# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Guild (server) ID where slash commands are registered - guild commands update instantly
DISCORD_GUILD_ID=

# Twitch (https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Minecraft RCON (see README for server.properties)
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=

# How often to poll Twitch, in seconds
CHECK_INTERVAL_SECONDS=60

# Optional: LuckPerms suffix applied while live (legacy & colour codes), and its priority
# LIVE_SUFFIX= &c🎥
# SUFFIX_PRIORITY=100
# Optional: set to false to disable the in-game [LIVE] broadcast
# ANNOUNCE_LIVE=true
