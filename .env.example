# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Guild (server) ID where slash commands are registered - guild commands update instantly
DISCORD_GUILD_ID=

# Twitch (https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# TwitchTabBadge plugin endpoint (see the plugin's config.yml: http.port and http.secret-token)
MC_HTTP_URL=http://127.0.0.1:25585/api/status
MC_SECRET_TOKEN=

# How often to poll Twitch, in seconds
CHECK_INTERVAL_SECONDS=60
