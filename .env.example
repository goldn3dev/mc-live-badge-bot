# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Guild (server) ID where slash commands are registered - guild commands update instantly
DISCORD_GUILD_ID=

# Twitch (https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# TwitchTabBadge plugin endpoint (see the plugin's config.yml: http.port and http.secret-token).
# Optional at startup: until both are set, the bot runs but skips Minecraft sync.
MC_HTTP_URL=http://127.0.0.1:25585/api/status
MC_SECRET_TOKEN=

# How often to poll Twitch, in seconds
CHECK_INTERVAL_SECONDS=60

# Database. Default is a local SQLite file; set DATABASE_URL (e.g. a free Turso database) for
# hosts with no persistent disk such as Render's free plan. DATABASE_URL wins if both are set.
# DATABASE_PATH=./data.sqlite
# DATABASE_URL=libsql://your-db-your-org.turso.io
# DATABASE_AUTH_TOKEN=

# Port for the health-check HTTP server (Render sets this automatically)
# PORT=10000
